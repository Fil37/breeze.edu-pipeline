# Copy to .env (git-ignored) and fill in only the keys you use. Never commit .env.

# --- LLM: only the key of the provider set in schemas/settings.json ("llm_provider") is needed.
#     No automatic fallback from one provider to another.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# "bedrock" (AWS)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-north-1
# "ollama" runs locally: no key.

# --- Voice-over (app/tts_manager.py). Without a key, edge-tts (free, no key) speaks.
ELEVENLABS_API_KEY=
# Optional: the voice of a channel with none in schemas/settings.json ("voice_by_channel"; ElevenLabs
# app: Voices -> the voice -> "Copy voice ID") and a model.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=

# --- Film behind a video's hook (app/render/footage.py): Pixabay's free API key (pixabay.com/api/docs).
#     Only a few French words are sent. Without it, only clips in assets/footage/local/ are used.
PIXABAY_API_KEY=

# --- Publishing (agent008, private uploads). One refresh token per channel.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN_BREEZE_ELECTRONICS=
YOUTUBE_REFRESH_TOKEN_BREEZE_PHYSICS=
YOUTUBE_REFRESH_TOKEN_BREEZE_MATH=
YOUTUBE_REFRESH_TOKEN_BREEZE_ECONOMICS=
UPLOADPOST_API_KEY=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
